<Window x:Class="Chattyn.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Chattyn.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Chattyn settings" Width="560" Height="720" MinWidth="440" MinHeight="400"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="#FF1B1D23" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource FlatButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="12,5" />
                <Button Style="{StaticResource AccentButton}" Content="Save" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <TextBlock Style="{StaticResource SectionLabel}" Text="Anthropic API key" Margin="0,0,0,4" />
                <TextBlock Text="{Binding KeyStatus}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KeyFound}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="The key is read from a .env file (ANTHROPIC_API_KEY=...). It is plain text on disk: use a dedicated key with a low monthly spend limit, and never share the folder with .env inside." />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="Create / open .env" Command="{Binding OpenEnvFileCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Reload key" Command="{Binding ReloadKeyCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Languages" />
                <TextBlock Text="Translate into (comma separated, e.g. Czech, German)" Style="{StaticResource Muted}" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding TranslationLanguages, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" />
                <TextBlock Text="Explain mistakes in" Style="{StaticResource Muted}" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding ExplanationLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Your character" />
                <TextBlock Text="Character and style notes (who they are, how they speak). Helps the natural version keep their voice." Style="{StaticResource Muted}" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding CharacterNotes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="70" Margin="0,3,0,8" />
                <TextBlock Text="Extra names and lore words, one per line (kept as written and not marked as typos)" Style="{StaticResource Muted}" />
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding LoreWords, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="70" Margin="0,3,0,0" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Hotkeys" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Show / back to game" Style="{StaticResource Muted}" />
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding ToggleHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Copy next part of a long post" Style="{StaticResource Muted}" />
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding NextPartHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Checking" />
                <TextBlock Text="Model" Style="{StaticResource Muted}" />
                <ComboBox ItemsSource="{Binding KnownModels}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" Margin="0,3,0,4" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="claude-haiku-5-5: fastest and cheapest (default). Sonnet and Opus give more polished style at a higher price." />
                <CheckBox IsChecked="{Binding AutoCheck}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                          Content="Check automatically when I stop typing" />
                <DockPanel Margin="22,4,0,0" IsEnabled="{Binding AutoCheck}">
                    <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" Style="{StaticResource Muted}"
                               Text="{Binding AutoCheckDelaySeconds, StringFormat={}{0:0.0} s}" />
                    <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding AutoCheckDelaySeconds}" />
                </DockPanel>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Sending to chat" />
                <DockPanel>
                    <TextBlock Text="Chat message limit (bytes)" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding ChunkLimitBytes, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" HorizontalAlignment="Right" />
                </DockPanel>
                <CheckBox IsChecked="{Binding NumberParts}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                          Content="Number the parts of long posts, e.g. (1/3)" />
                <CheckBox IsChecked="{Binding NormalizePunctuation}" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"
                          Content="Plain punctuation for WoW (straight quotes, ..., -) and one line" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Window" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="170" Text="Opacity while playing" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"
                               Text="{Binding IdleOpacity, StringFormat={}{0:P0}}" />
                    <Slider Minimum="0.2" Maximum="1" Value="{Binding IdleOpacity}" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Width="170" Text="Opacity while writing" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Muted}"
                               Text="{Binding ActiveOpacity, StringFormat={}{0:P0}}" />
                    <Slider Minimum="0.4" Maximum="1" Value="{Binding ActiveOpacity}" />
                </DockPanel>
                <CheckBox IsChecked="{Binding StartWithWindows}" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"
                          Content="Start Chattyn with Windows" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                           Text="WoW must run in Windowed or Windowed (Fullscreen) mode; exclusive fullscreen hides overlays. If WoW runs as administrator, run Chattyn as administrator too, or the hotkeys may not work in game." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
